# pfSense Configuration
PFSENSE_HOST=https://your-pfsense-ip
PFSENSE_API_KEY=your-api-key-here
PFSENSE_API_SECRET=your-api-secret-here

# Optional: Disable SSL verification for self-signed certificates
# NODE_TLS_REJECT_UNAUTHORIZED=0

# WireGuard private key -- overrides or substitutes for PrivateKey in the .conf file.
# Set this so the .conf can be committed to the repo without the secret.
# WG_PRIVATE_KEY=your-base64-private-key-here
